# Livson Tecnologia — URLs limpas (sem .html)

RewriteEngine On

# Se alguém pedir a URL com .html, redireciona pra versão limpa (evita conteúdo duplicado)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve o arquivo .html internamente quando a URL limpa é acessada
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]
