# Livson Tecnologia — URLs limpas (sem .html)

RewriteEngine On

# Se alguém pedir a URL com .html, redireciona pra versão limpa (evita conteúdo duplicado)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve o arquivo .html internamente quando a URL limpa é acessada
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# ---------------------------------------------------------------
# Cache
# O HTML nunca pode ficar preso em cache: é ele que aponta para as
# versões atuais do CSS/JS (via ?v=). Os arquivos CSS/JS podem ter
# cache longo justamente porque o ?v= muda quando eles mudam.
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
